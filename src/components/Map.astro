---
interface Props {
  spots: Array<{
    id: string;
    name: string;
    cluster: string;
    type: string[];
    vibe: string;
    stamina_cost: string;
    backpack_friendly: string;
    coordinates: [number, number];
    status: string;
    closed_year?: number;
  }>;
  initialCluster?: string;
  height?: string;
}

const { spots = [], initialCluster, height = "520px" } = Astro.props;
---

<div class="relative w-full rounded-2xl overflow-hidden border border-paper-border shadow-sm bg-white">
  <!-- 地圖控制器容器 (左上方雙層導覽) -->
  <div class="absolute top-4 left-4 z-20 flex flex-col gap-2 max-w-[calc(100%-2rem)] sm:max-w-none">
    <!-- 商圈密度快速聚焦 (按密度優先) -->
    <div class="bg-white/95 backdrop-blur-md px-3 py-2 rounded-xl shadow-sm border border-paper-border flex flex-wrap items-center gap-1.5 text-xs">
      <span class="font-serif font-bold text-accent text-xs mr-1">密度聚焦:</span>
      <button 
        id="jump-ximen" 
        class="jump-btn active px-2.5 py-1 rounded-lg font-medium transition bg-accent text-white flex items-center gap-1"
        title="密度最高，精確街角視角"
      >
        <span>📍 西門核心</span>
        <span class="text-[10px] font-mono opacity-80">(10)</span>
      </button>
      <button 
        id="jump-y-underground" 
        class="jump-btn px-2.5 py-1 rounded-lg font-medium transition bg-paper-hover text-ink-muted hover:text-ink"
      >
        台北地下街/站前 (7)
      </button>
      <button 
        id="jump-syntrend" 
        class="jump-btn px-2.5 py-1 rounded-lg font-medium transition bg-paper-hover text-ink-muted hover:text-ink"
      >
        光華三創 (4)
      </button>
      <button 
        id="jump-all-view" 
        class="jump-btn px-2.5 py-1 rounded-lg font-medium transition bg-paper-hover text-ink-muted hover:text-ink flex items-center gap-1"
      >
        <span>🗺️ 全景 (25)</span>
      </button>
    </div>

    <!-- 狀態篩選 -->
    <div class="bg-white/95 backdrop-blur-md px-3 py-1.5 rounded-xl shadow-sm border border-paper-border flex flex-wrap items-center gap-1.5 text-xs">
      <span class="font-serif font-bold text-ink text-[11px] mr-1">狀態:</span>
      <button 
        id="filter-all" 
        class="filter-btn active px-2 py-0.5 rounded-lg font-medium transition bg-ink text-white text-[11px]"
      >
        全部 ({spots.length})
      </button>
      <button 
        id="filter-active" 
        class="filter-btn px-2 py-0.5 rounded-lg font-medium transition bg-paper-hover text-ink-muted hover:text-ink text-[11px]"
      >
        開著呢 ({spots.filter(s => s.status === 'active').length})
      </button>
      <button 
        id="filter-archive" 
        class="filter-btn px-2 py-0.5 rounded-lg font-medium transition bg-archive-bg text-archive hover:text-ink text-[11px]"
      >
        留在昨天 ({spots.filter(s => s.status === 'archive').length})
      </button>
    </div>
  </div>

  <!-- 地圖容器 -->
  <div id="taipei-anime-map" style={`height: ${height}; width: 100%;`} class="z-10"></div>
</div>

<!-- 傳遞點位資料至客戶端腳本 -->
<script define:vars={{ spots, initialCluster }}>
  function initMap() {
    if (typeof L === 'undefined') {
      setTimeout(initMap, 100);
      return;
    }

    // 依據使用者指示：以地點密度最高之西門核心商圈為優先，深度 zoom-in (zoom: 16)
    // 第一印象即呈現細膩街道、老巷弄與緊湊標記
    const defaultCenter = [25.0442, 121.5080];
    const defaultZoom = 16;

    const map = L.map('taipei-anime-map', {
      center: defaultCenter,
      zoom: defaultZoom,
      zoomControl: false,
      scrollWheelZoom: false
    });

    L.control.zoom({ position: 'bottomright' }).addTo(map);

    // CARTO Positron 極簡淡灰日系底圖
    L.tileLayer('https://{s}.basemaps.cartocdn.com/light_all/{z}/{x}/{y}{r}.png', {
      attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> &copy; <a href="https://carto.com/attributions">CARTO</a>',
      subdomains: 'abcd',
      maxZoom: 19
    }).addTo(map);

    let currentFilter = 'all';
    let markersLayer = L.layerGroup().addTo(map);
    const allBounds = [];

    function createMarkerIcon(spot) {
      const isArchive = spot.status === 'archive';
      const color = isArchive ? '#8C4830' : '#E05A47';
      const label = isArchive ? '昨' : '歩';

      return L.divIcon({
        className: 'custom-pin',
        html: `
          <div style="
            background: ${isArchive ? '#EDEAE3' : '#FFFFFF'};
            border: 2px solid ${color};
            color: ${color};
            border-radius: 9999px;
            width: 32px;
            height: 32px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 13px;
            font-family: serif;
            font-weight: bold;
            box-shadow: 0 2px 8px rgba(0,0,0,0.15);
            transform: translate(-50%, -50%);
            transition: all 0.2s ease;
          ">
            ${label}
          </div>
        `,
        iconSize: [32, 32],
        iconAnchor: [16, 16]
      });
    }

    function renderMarkers() {
      markersLayer.clearLayers();
      allBounds.length = 0;

      spots.forEach(spot => {
        if (currentFilter === 'active' && spot.status !== 'active') return;
        if (currentFilter === 'archive' && spot.status !== 'archive') return;

        const [lng, lat] = spot.coordinates;
        if (!lng || !lat) return;

        const marker = L.marker([lat, lng], { icon: createMarkerIcon(spot) });

        const isArchive = spot.status === 'archive';
        const popupContent = `
          <div style="font-family: sans-serif; min-width: 220px; padding: 4px;">
            <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 6px;">
              <span style="font-size: 10px; font-weight: 600; color: #666; background: #F3F0EA; padding: 2px 6px; border-radius: 4px;">
                ${spot.cluster}
              </span>
              ${isArchive ? `<span style="font-size: 10px; color: #8C4830; font-weight: bold; border: 1px solid #8C4830; padding: 1px 4px; border-radius: 3px;">留在昨天 (${spot.closed_year || ''})</span>` : ''}
            </div>
            <div style="font-size: 13px; font-family: serif; font-weight: bold; color: #22201E; margin-bottom: 4px;">
              ${spot.name}
            </div>
            <div style="font-size: 11px; color: #66615B; line-height: 1.4; margin-bottom: 8px;">
              ${spot.vibe}
            </div>
            <div style="display: flex; flex-wrap: wrap; gap: 4px; font-size: 10px; margin-bottom: 8px;">
              <span style="background: #FEF3EE; color: #B54A37; padding: 2px 6px; border-radius: 9999px;">
                🎒 ${spot.backpack_friendly}
              </span>
              <span style="background: #F3F0EA; color: #55504A; padding: 2px 6px; border-radius: 9999px;">
                ⚡ ${spot.stamina_cost}
              </span>
            </div>
            <a href="/taipei-anime-walk/spots/${spot.id}" style="display: block; text-align: center; background: #22201E; color: #FFFFFF; font-size: 11px; padding: 5px 0; border-radius: 6px; text-decoration: none; font-weight: 500;">
              看看隨筆 ➔
            </a>
          </div>
        `;

        marker.bindPopup(popupContent);
        markersLayer.addLayer(marker);
        allBounds.push([lat, lng]);
      });
      // 保持密度優先的深入 zoom 視野，不自動全幅拉遠
    }

    renderMarkers();

    // 綁定商圈聚焦按鈕
    const btnXimen = document.getElementById('jump-ximen');
    const btnUnderground = document.getElementById('jump-y-underground');
    const btnSyntrend = document.getElementById('jump-syntrend');
    const btnAllView = document.getElementById('jump-all-view');
    const allJumpBtns = [btnXimen, btnUnderground, btnSyntrend, btnAllView];

    function setJumpButtonActive(activeBtn) {
      allJumpBtns.forEach(btn => {
        if (!btn) return;
        btn.classList.remove('bg-accent', 'text-white');
        btn.classList.add('bg-paper-hover', 'text-ink-muted');
      });
      activeBtn.classList.remove('bg-paper-hover', 'text-ink-muted');
      activeBtn.classList.add('bg-accent', 'text-white');
    }

    if (btnXimen) {
      btnXimen.addEventListener('click', () => {
        setJumpButtonActive(btnXimen);
        map.flyTo([25.0442, 121.5080], 16, { duration: 0.8 });
      });
    }

    if (btnUnderground) {
      btnUnderground.addEventListener('click', () => {
        setJumpButtonActive(btnUnderground);
        map.flyTo([25.0485, 121.5150], 16, { duration: 0.8 });
      });
    }

    if (btnSyntrend) {
      btnSyntrend.addEventListener('click', () => {
        setJumpButtonActive(btnSyntrend);
        map.flyTo([25.0450, 121.5312], 16, { duration: 0.8 });
      });
    }

    if (btnAllView) {
      btnAllView.addEventListener('click', () => {
        setJumpButtonActive(btnAllView);
        if (allBounds.length > 0) {
          map.fitBounds(allBounds, { padding: [50, 50], maxZoom: 15 });
        }
      });
    }

    // 狀態篩選按鈕
    const btnAll = document.getElementById('filter-all');
    const btnActive = document.getElementById('filter-active');
    const btnArchive = document.getElementById('filter-archive');
    const allFilterBtns = [btnAll, btnActive, btnArchive];

    function setFilterButtonActive(activeBtn) {
      allFilterBtns.forEach(btn => {
        if (!btn) return;
        btn.classList.remove('bg-ink', 'text-white');
        btn.classList.add('bg-paper-hover', 'text-ink-muted');
      });
      activeBtn.classList.remove('bg-paper-hover', 'text-ink-muted');
      activeBtn.classList.add('bg-ink', 'text-white');
    }

    if (btnAll) {
      btnAll.addEventListener('click', () => {
        currentFilter = 'all';
        setFilterButtonActive(btnAll);
        renderMarkers();
      });
    }

    if (btnActive) {
      btnActive.addEventListener('click', () => {
        currentFilter = 'active';
        setFilterButtonActive(btnActive);
        renderMarkers();
      });
    }

    if (btnArchive) {
      btnArchive.addEventListener('click', () => {
        currentFilter = 'archive';
        setFilterButtonActive(btnArchive);
        renderMarkers();
      });
    }
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', () => {
      loadLeafletScript(initMap);
    });
  } else {
    loadLeafletScript(initMap);
  }

  function loadLeafletScript(callback) {
    if (window.L) {
      callback();
      return;
    }
    const script = document.createElement('script');
    script.src = 'https://unpkg.com/leaflet@1.9.4/dist/leaflet.js';
    script.onload = callback;
    document.head.appendChild(script);
  }
</script>
