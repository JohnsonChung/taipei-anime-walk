---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "台北動漫散步指南 | Taipei Anime Walk",
  description = "一本帶著個人品味、同好黑話、體感溫度與文化記憶的台北二次元線上風格獨立誌兼散步地圖。"
} = Astro.props;
---

<!DOCTYPE html>
<html lang="zh-TW" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    
    <!-- Google Fonts: Noto Sans TC & Noto Serif TC -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Noto+Sans+TC:wght@400;500;700&family=Noto+Serif+TC:wght@600;900&display=swap" rel="stylesheet">
    
    <!-- Leaflet CSS -->
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
  </head>
  <body class="paper-texture min-h-screen flex flex-col text-ink selection:bg-accent-light selection:text-accent">
    <!-- 頂部導覽 -->
    <header class="sticky top-0 z-40 bg-paper/95 backdrop-blur-sm border-b border-paper-border">
      <div class="max-w-6xl mx-auto px-4 sm:px-6 h-16 flex items-center justify-between">
        <a href="/" class="flex items-center gap-3 group">
          <span class="w-8 h-8 rounded-full bg-accent flex items-center justify-center text-white font-serif font-black text-sm shadow-sm group-hover:bg-accent-hover transition">
            漫
          </span>
          <div class="flex flex-col">
            <span class="font-serif font-bold text-lg leading-tight tracking-wide text-ink group-hover:text-accent transition">
              台北動漫散步指南
            </span>
            <span class="text-[10px] tracking-wider text-ink-muted font-mono uppercase">
              Taipei Anime Walk • Webzine
            </span>
          </div>
        </a>

        <nav class="hidden md:flex items-center gap-6 text-sm font-medium text-ink-muted">
          <a href="/#walks" class="hover:text-accent transition">散步特輯</a>
          <a href="/#map" class="hover:text-accent transition">探索地圖</a>
          <a href="/spots" class="hover:text-accent transition">全部點位</a>
          <a href="/archive" class="hover:text-accent flex items-center gap-1 transition">
            <span>時光膠囊</span>
            <span class="text-[10px] bg-archive-bg text-archive px-1.5 py-0.5 rounded font-mono">Archive</span>
          </a>
          <a href="/about" class="hover:text-accent transition">關於指南</a>
        </nav>

        <div class="flex items-center gap-3">
          <a 
            href="https://github.com/JohnsonChung/taipei-anime-walk" 
            target="_blank" 
            rel="noopener noreferrer"
            class="text-xs font-mono px-3 py-1.5 rounded-full border border-paper-border bg-white hover:border-ink-muted text-ink-muted hover:text-ink transition flex items-center gap-1.5"
          >
            <span>GitHub 投稿沙龍</span>
            <span class="text-accent">↗</span>
          </a>
        </div>
      </div>
    </header>

    <!-- 主內容區 -->
    <main class="flex-grow">
      <slot />
    </main>

    <!-- 頁尾 -->
    <footer class="border-t border-paper-border bg-white mt-16 py-12">
      <div class="max-w-6xl mx-auto px-4 sm:px-6">
        <div class="grid grid-cols-1 md:grid-cols-4 gap-8 mb-8">
          <div class="md:col-span-2 space-y-3">
            <div class="flex items-center gap-2">
              <span class="w-6 h-6 rounded-full bg-accent text-white flex items-center justify-center font-serif text-xs font-bold">漫</span>
              <span class="font-serif font-bold text-base">台北動漫散步指南</span>
            </div>
            <p class="text-xs text-ink-muted leading-relaxed max-w-md">
              這不是商業黃頁資料庫，而是一本帶著個人品味、同好黑話、體感溫度與文化記憶的台北二次元線上獨立誌。完全無商業廣告、無店家付費推廣。
            </p>
            <div class="text-[11px] font-mono text-ink-light pt-2">
              ZERO SPONSORED PINS • ANTI-DECAY ARCHITECTURE • CC-BY-NC 4.0
            </div>
          </div>

          <div>
            <h4 class="font-serif font-bold text-xs tracking-wider uppercase text-ink mb-3">漫遊商圈</h4>
            <ul class="space-y-2 text-xs text-ink-muted font-medium">
              <li><a href="/spots?cluster=西門商圈" class="hover:text-accent">西門町商圈</a></li>
              <li><a href="/spots?cluster=台北地下街" class="hover:text-accent">台北地下街 Y 區</a></li>
              <li><a href="/spots?cluster=光華三創" class="hover:text-accent">八德光華 • 三創生活</a></li>
              <li><a href="/spots?cluster=公館台大" class="hover:text-accent">公館台大同人聚落</a></li>
            </ul>
          </div>

          <div>
            <h4 class="font-serif font-bold text-xs tracking-wider uppercase text-ink mb-3">專案協作</h4>
            <ul class="space-y-2 text-xs text-ink-muted">
              <li><a href="/about" class="hover:text-accent">編輯室宣言</a></li>
              <li><a href="/archive" class="hover:text-accent">歇業名店封存清單</a></li>
              <li><a href="https://github.com/JohnsonChung/taipei-anime-walk/issues/new/choose" target="_blank" class="hover:text-accent">Issue Form 點位投稿</a></li>
              <li><a href="https://github.com/JohnsonChung/taipei-anime-walk" target="_blank" class="hover:text-accent">GitHub 源碼庫</a></li>
            </ul>
          </div>
        </div>

        <div class="pt-6 border-t border-paper-border flex flex-col sm:flex-row items-center justify-between gap-4 text-[11px] text-ink-light font-mono">
          <div>© 2026 Taipei Anime Walk. Curated with love by local anime walkers.</div>
          <div>BUILT WITH ASTRO + TAILWIND + LEAFLET</div>
        </div>
      </div>
    </footer>
  </body>
</html>
