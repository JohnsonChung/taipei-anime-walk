---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "台北動漫散步指南 | Taipei Anime Walk",
  description = "今天好像也沒什麼特別的目的，只是想出門走一走。記錄台北街頭那些吹著冷氣、翻翻舊書、走累了就坐下發呆的日常二次元散步隨筆。"
} = Astro.props;
---

<!DOCTYPE html>
<html lang="zh-TW" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    
    <!-- Google Fonts: Noto Sans TC & Noto Serif TC -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Noto+Sans+TC:wght@400;500;700&family=Noto+Serif+TC:wght@400;600;900&display=swap" rel="stylesheet">
    
    <!-- Leaflet CSS -->
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
  </head>
  <body class="paper-texture min-h-screen flex flex-col text-ink selection:bg-accent-light selection:text-accent font-sans">
    <!-- 頂部導覽 -->
    <header class="sticky top-0 z-40 bg-paper/95 backdrop-blur-sm border-b border-paper-border">
      <div class="max-w-5xl mx-auto px-4 sm:px-6 h-16 flex items-center justify-between">
        <a href="/taipei-anime-walk/" class="flex items-center gap-3 group">
          <span class="w-8 h-8 rounded-full bg-accent/90 flex items-center justify-center text-white font-serif font-bold text-sm shadow-sm group-hover:bg-accent transition">
            歩
          </span>
          <div class="flex flex-col">
            <span class="font-serif font-bold text-base sm:text-lg leading-tight tracking-wide text-ink group-hover:text-accent transition">
              台北動漫散步指南
            </span>
            <span class="text-[10px] tracking-wider text-ink-light font-mono">
              Taipei Anime Walk • 日常散步隨筆
            </span>
          </div>
        </a>

        <nav class="hidden md:flex items-center gap-6 text-xs sm:text-sm font-medium text-ink-muted">
          <a href="/taipei-anime-walk/walks" class="hover:text-accent transition">散步路線</a>
          <a href="/taipei-anime-walk/#map" class="hover:text-accent transition">街道地圖</a>
          <a href="/taipei-anime-walk/spots" class="hover:text-accent transition">走過的地方</a>
          <a href="/taipei-anime-walk/archive" class="hover:text-accent flex items-center gap-1 transition">
            <span>留在昨天</span>
            <span class="text-[10px] bg-archive-bg text-archive px-1.5 py-0.5 rounded font-mono">Archive</span>
          </a>
          <a href="/taipei-anime-walk/about" class="hover:text-accent transition">關於這裡</a>
        </nav>

        <div class="flex items-center gap-3">
          <a 
            href="https://github.com/JohnsonChung/taipei-anime-walk" 
            target="_blank" 
            rel="noopener noreferrer"
            class="text-xs px-3 py-1.5 rounded-full border border-paper-border bg-white hover:border-ink-muted text-ink-muted hover:text-ink transition flex items-center gap-1.5"
          >
            <span>GitHub 隨筆箱</span>
            <span class="text-accent text-[10px]">↗</span>
          </a>
        </div>
      </div>
    </header>

    <!-- 主內容區 -->
    <main class="flex-grow">
      <slot />
    </main>

    <!-- 頁尾：日常散文氛圍 -->
    <footer class="border-t border-paper-border bg-white mt-16 py-12">
      <div class="max-w-5xl mx-auto px-4 sm:px-6">
        <div class="grid grid-cols-1 md:grid-cols-3 gap-8 mb-8">
          <div class="md:col-span-2 space-y-3">
            <div class="flex items-center gap-2">
              <span class="w-6 h-6 rounded-full bg-accent/80 text-white flex items-center justify-center font-serif text-xs">歩</span>
              <span class="font-serif font-bold text-sm text-ink">台北動漫散步指南</span>
            </div>
            <p class="text-xs text-ink-muted leading-relaxed max-w-md font-serif">
              今天沒買到想要的東西也無所謂。在長凳上喝完一杯微糖茶，看著人潮從眼前走過去，偶爾這樣漫無目的過一天，也挺好的。
            </p>
            <div class="text-[11px] font-mono text-ink-light pt-1">
              AIMLESS WALKS • DAILY SLICE OF LIFE • ZERO ADS
            </div>
          </div>

          <div>
            <h4 class="font-serif font-bold text-xs tracking-wider text-ink mb-3">常去晃晃的角落</h4>
            <ul class="space-y-2 text-xs text-ink-muted">
              <li><a href="/taipei-anime-walk/spots?cluster=西門商圈" class="hover:text-accent">西門的老大樓與街道</a></li>
              <li><a href="/taipei-anime-walk/spots?cluster=台北地下街" class="hover:text-accent">雨天的地下街長廊</a></li>
              <li><a href="/taipei-anime-walk/spots?cluster=光華三創" class="hover:text-accent">吹冷氣看展的三創角落</a></li>
              <li><a href="/taipei-anime-walk/archive" class="hover:text-accent">那些已經拉下鐵捲門的小店</a></li>
            </ul>
          </div>
        </div>

        <div class="pt-6 border-t border-paper-border flex flex-col sm:flex-row items-center justify-between gap-4 text-[11px] text-ink-light font-mono">
          <div>Taipei Anime Walk — 沒有特定目的的日常散步筆記</div>
          <div><a href="https://github.com/JohnsonChung/taipei-anime-walk" target="_blank" class="hover:underline">GitHub</a></div>
        </div>
      </div>
    </footer>
  </body>
</html>
