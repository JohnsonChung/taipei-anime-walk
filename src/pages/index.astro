---
import BaseLayout from '../layouts/BaseLayout.astro';
import Map from '../components/Map.astro';
import WalkCard from '../components/WalkCard.astro';
import SpotCard from '../components/SpotCard.astro';
import { getCollection } from 'astro:content';

const allWalks = await getCollection('walks');
const allSpots = await getCollection('spots');

const mapSpotsData = allSpots.map(s => ({
  id: s.slug,
  name: s.data.name,
  cluster: s.data.cluster,
  type: s.data.type,
  vibe: s.data.vibe,
  stamina_cost: s.data.stamina_cost,
  backpack_friendly: s.data.backpack_friendly,
  coordinates: s.data.coordinates,
  status: s.data.status,
  closed_year: s.data.closed_year,
}));

const activeSpots = allSpots.filter(s => s.data.status === 'active');
const archiveSpots = allSpots.filter(s => s.data.status === 'archive');
---

<BaseLayout>
  <!-- Hero: 和風日常短篇散文氛圍 -->
  <section class="max-w-5xl mx-auto px-4 sm:px-6 pt-12 pb-14">
    <div class="border-b border-paper-border pb-10">
      <div class="flex items-center gap-2 mb-4 text-xs font-mono text-ink-light">
        <span>台北</span>
        <span>•</span>
        <span>午後散步隨筆</span>
      </div>

      <h1 class="font-serif font-black text-3xl sm:text-4xl lg:text-5xl text-ink tracking-tight leading-[1.3] mb-6">
        今天好像也沒什麼特別的目的，<br />
        只是想出門走一走。
      </h1>

      <p class="text-sm sm:text-base text-ink-muted leading-relaxed max-w-2xl font-serif mb-8">
        轉角手扶梯吹來的冷氣微風、沒拆封模型盒特有的紙箱油墨味，還有那些走累了就坐下來發呆的台北角落。沒有一定要買到的東西，也沒有非去不可的答案。只是想把放空的自己帶出門散步一會兒。
      </p>

      <!-- 日常三個小方向 -->
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 pt-2 text-xs">
        <a href="#walks" class="p-4 rounded-xl bg-white border border-paper-border hover:border-accent transition group">
          <div class="font-mono text-accent text-[11px] mb-1">01 / WALKS</div>
          <div class="font-serif font-bold text-sm text-ink group-hover:text-accent transition">漫無目的的一日路線</div>
          <div class="text-[11px] text-ink-light mt-1">走累了隨時能停下來休息</div>
        </a>

        <a href="#map" class="p-4 rounded-xl bg-white border border-paper-border hover:border-accent transition group">
          <div class="font-mono text-accent text-[11px] mb-1">02 / SPOTS</div>
          <div class="font-serif font-bold text-sm text-ink group-hover:text-accent transition">街道與角落地圖</div>
          <div class="text-[11px] text-ink-light mt-1">看看附近有沒有可以晃晃的地方</div>
        </a>

        <a href="/taipei-anime-walk/archive" class="p-4 rounded-xl bg-archive-bg/40 border border-archive/30 hover:border-archive transition group">
          <div class="font-mono text-archive text-[11px] mb-1">03 / MEMORY</div>
          <div class="font-serif font-bold text-sm text-ink group-hover:text-archive transition">留在昨天的小店</div>
          <div class="text-[11px] text-ink-light mt-1">那些已經拉下鐵捲門的回憶</div>
        </a>
      </div>
    </div>
  </section>

  <!-- 散步路線 (Walks) -->
  <section id="walks" class="max-w-5xl mx-auto px-4 sm:px-6 py-10">
    <div class="flex flex-col sm:flex-row sm:items-end justify-between mb-8 gap-3">
      <div>
        <div class="text-[11px] font-mono text-accent tracking-wider mb-1">WALK ROUTES</div>
        <h2 class="font-serif font-bold text-2xl text-ink">
          今天想去哪裡走走？
        </h2>
      </div>
      <p class="text-xs text-ink-light max-w-sm">
        不用急著把點踩完。挑一條舒服的路線，順著心情慢慢逛就好。
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      {allWalks.map(walk => (
        <WalkCard walk={walk} />
      ))}
    </div>
  </section>

  <!-- 地圖 (Map) -->
  <section id="map" class="max-w-5xl mx-auto px-4 sm:px-6 py-10">
    <div class="flex flex-col sm:flex-row sm:items-end justify-between mb-6 gap-3">
      <div>
        <div class="text-[11px] font-mono text-accent tracking-wider mb-1">STREET MAP</div>
        <h2 class="font-serif font-bold text-2xl text-ink">
          街道上的小小標記
        </h2>
      </div>
      <div class="text-xs text-ink-light font-mono flex items-center gap-4">
        <span>● 開著的店: {activeSpots.length}</span>
        <span class="text-archive">■ 留在昨天: {archiveSpots.length}</span>
      </div>
    </div>

    <Map spots={mapSpotsData} height="480px" />
  </section>

  <!-- 剛好路過的地方 (Spots) -->
  <section class="max-w-5xl mx-auto px-4 sm:px-6 py-10">
    <div class="flex items-center justify-between mb-8">
      <div>
        <div class="text-[11px] font-mono text-accent tracking-wider mb-1">NOTES ALONG THE WAY</div>
        <h2 class="font-serif font-bold text-2xl text-ink">
          剛好路過的店鋪隨筆
        </h2>
      </div>
      <a href="/taipei-anime-walk/spots" class="text-xs font-semibold text-accent hover:underline">
        看全部角落 ({allSpots.length}) ➔
      </a>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
      {allSpots.slice(0, 3).map(spot => (
        <SpotCard spot={spot} />
      ))}
    </div>
  </section>

  <!-- 投稿小箱 (CTA) -->
  <section class="max-w-5xl mx-auto px-4 sm:px-6 py-12">
    <div class="bg-white rounded-2xl border border-paper-border p-6 sm:p-8 shadow-sm">
      <div class="max-w-xl">
        <span class="text-xs font-serif text-accent mb-2 block font-medium">
          寫下一點生活碎屑
        </span>
        <h3 class="font-serif font-bold text-xl text-ink mb-3 leading-snug">
          如果你也在台北街頭，發現了某個舒服的角落
        </h3>
        <p class="text-xs text-ink-muted leading-relaxed mb-6 font-serif">
          「那家店的冷氣很舒服」、「那條走道背大包包要側身過」、「轉角有一張長凳很適合發呆」——這些微不足道的小事，都歡迎隨手丟到 GitHub 投稿箱裡，分享給同樣愛散步的人。
        </p>
        <div class="flex flex-wrap gap-3">
          <a 
            href="https://github.com/JohnsonChung/taipei-anime-walk/issues/new/choose" 
            target="_blank"
            class="px-5 py-2.5 rounded-xl bg-ink text-white font-medium text-xs hover:bg-accent transition flex items-center gap-2"
          >
            <span>打開 GitHub 隨筆箱</span>
            <span>➔</span>
          </a>
          <a 
            href="/taipei-anime-walk/about" 
            class="px-5 py-2.5 rounded-xl border border-paper-border bg-paper-hover text-ink text-xs hover:border-ink-muted transition"
          >
            關於散步隨筆
          </a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
