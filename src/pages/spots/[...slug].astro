---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const spots = await getCollection('spots');
  return spots.map(spot => ({
    params: { slug: spot.slug },
    props: { spot }
  }));
}

const { spot } = Astro.props;
const { Content } = await spot.render();
const { name, district, cluster, type, vibe, stamina_cost, backpack_friendly, coordinates, google_maps_url, status, closed_year, contributor } = spot.data;
const isArchive = status === 'archive';
---

<BaseLayout title={`${name} | 台北動漫散步指南`}>
  <article class="max-w-2xl mx-auto px-4 sm:px-6 py-12">
    <!-- 頂部返回 -->
    <div class="mb-8 flex items-center justify-between">
      <a href="/taipei-anime-walk/spots" class="text-xs font-mono text-ink-light hover:text-accent transition flex items-center gap-1">
        ← 回到店鋪隨筆
      </a>
      <span class="text-xs font-mono text-ink-light">
        {contributor}
      </span>
    </div>

    <!-- 標題區域 -->
    <header class="border-b border-paper-border pb-8 mb-8">
      <div class="flex items-center gap-3 mb-3">
        <span class="text-xs font-medium px-2.5 py-1 rounded-full bg-paper-hover text-ink-muted">
          📍 {cluster} • {district}
        </span>
        {isArchive ? (
          <span class="stamp-badge">
            留在昨天 {closed_year ? `• ${closed_year}` : ''}
          </span>
        ) : (
          <span class="text-xs text-accent font-medium flex items-center gap-1">
            <span class="w-1.5 h-1.5 rounded-full bg-accent"></span>
            開著呢
          </span>
        )}
      </div>

      <h1 class="font-serif font-black text-2xl sm:text-3xl text-ink tracking-tight mb-3">
        {name}
      </h1>

      <p class="text-sm text-ink-muted leading-relaxed font-serif mb-6">
        {vibe}
      </p>

      <!-- 體感小提示 -->
      <div class="grid grid-cols-2 sm:grid-cols-3 gap-3 bg-white p-4 rounded-xl border border-paper-border text-xs">
        <div>
          <div class="text-[10px] font-mono text-ink-light mb-1">背包走道</div>
          <div class="text-xs font-medium text-accent">🎒 {backpack_friendly}</div>
        </div>
        <div>
          <div class="text-[10px] font-mono text-ink-light mb-1">散步步調</div>
          <div class="text-xs font-medium text-ink">⚡ {stamina_cost}</div>
        </div>
        <div class="col-span-2 sm:col-span-1">
          <div class="text-[10px] font-mono text-ink-light mb-1">大概位置</div>
          <div class="text-xs font-mono text-ink-light">{coordinates[0]}, {coordinates[1]}</div>
        </div>
      </div>

      <!-- 分類標籤 -->
      <div class="flex flex-wrap gap-1.5 mt-4">
        {type.map(t => (
          <span class="text-[11px] px-2 py-0.5 rounded bg-paper text-ink-light font-mono">
            #{t}
          </span>
        ))}
      </div>
    </header>

    <!-- 隨筆正文 -->
    <div class="prose prose-neutral max-w-none text-ink-muted leading-relaxed font-serif mb-10">
      <Content />
    </div>

    <!-- 外部導航與回饋列 -->
    <div class="pt-6 border-t border-paper-border flex flex-col sm:flex-row items-center justify-between gap-4">
      {google_maps_url ? (
        <a 
          href={google_maps_url} 
          target="_blank" 
          rel="noopener noreferrer"
          class="w-full sm:w-auto px-4 py-2 rounded-xl bg-ink text-white text-xs hover:bg-accent transition text-center flex items-center justify-center gap-1.5"
        >
          <span>在 Google Maps 查看位置</span>
          <span class="text-[10px]">↗</span>
        </a>
      ) : (
        <span class="text-xs text-ink-light font-mono">這家店已經不在了</span>
      )}

      <a 
        href="https://github.com/JohnsonChung/taipei-anime-walk/issues/new/choose" 
        target="_blank" 
        class="text-xs text-ink-light hover:text-accent font-sans"
      >
        有資訊想補充？在 GitHub 隨筆箱留言 ➔
      </a>
    </div>
  </article>
</BaseLayout>
