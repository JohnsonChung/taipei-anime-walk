---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const spots = await getCollection('spots');
  return spots.map(spot => ({
    params: { slug: spot.slug },
    props: { spot }
  }));
}

const { spot } = Astro.props;
const { Content } = await spot.render();
const { name, district, cluster, type, vibe, stamina_cost, backpack_friendly, coordinates, google_maps_url, status, closed_year, contributor, updated_at } = spot.data;
const isArchive = status === 'archive';
---

<BaseLayout title={`${name} | 台北動漫散步指南`}>
  <article class="max-w-3xl mx-auto px-4 sm:px-6 py-12">
    <!-- 頂部返回 -->
    <div class="mb-8 flex items-center justify-between">
      <a href="/spots" class="text-xs font-mono text-ink-muted hover:text-accent transition flex items-center gap-1">
        ← 返回點位清單
      </a>
      <span class="text-xs font-mono text-ink-light">
        貢獻者：{contributor}
      </span>
    </div>

    <!-- 標題區域 -->
    <header class="border-b border-paper-border pb-8 mb-8">
      <div class="flex items-center gap-3 mb-3">
        <span class="text-xs font-semibold px-2.5 py-1 rounded-full bg-paper-hover text-ink-muted">
          📍 {cluster} • {district}
        </span>
        {isArchive ? (
          <span class="stamp-badge">
            時光膠囊 {closed_year ? `• ${closed_year} 歇業` : ''}
          </span>
        ) : (
          <span class="text-xs text-accent font-medium flex items-center gap-1">
            <span class="w-2 h-2 rounded-full bg-accent animate-pulse"></span>
            活躍點位
          </span>
        )}
      </div>

      <h1 class="font-serif font-black text-3xl sm:text-4xl text-ink tracking-tight mb-3">
        {name}
      </h1>

      <p class="text-base text-ink-muted leading-relaxed font-serif italic mb-6">
        「{vibe}」
      </p>

      <!-- 體感量表與空間指標卡 -->
      <div class="grid grid-cols-2 sm:grid-cols-3 gap-3 bg-white p-5 rounded-2xl border border-paper-border">
        <div>
          <div class="text-[10px] font-mono text-ink-light uppercase mb-1">背包友善度</div>
          <div class="text-xs font-semibold text-accent">🎒 {backpack_friendly}</div>
        </div>
        <div>
          <div class="text-[10px] font-mono text-ink-light uppercase mb-1">體力消耗</div>
          <div class="text-xs font-semibold text-ink">⚡ {stamina_cost}</div>
        </div>
        <div class="col-span-2 sm:col-span-1">
          <div class="text-[10px] font-mono text-ink-light uppercase mb-1">地理座標</div>
          <div class="text-xs font-mono text-ink-muted">{coordinates[0]}, {coordinates[1]}</div>
        </div>
      </div>

      <!-- 分類標籤 -->
      <div class="flex flex-wrap gap-2 mt-4">
        {type.map(t => (
          <span class="text-xs px-2.5 py-1 rounded bg-paper text-ink-muted border border-paper-border font-mono">
            #{t}
          </span>
        ))}
      </div>
    </header>

    <!-- 漫遊筆記正文 -->
    <div class="prose prose-neutral max-w-none text-ink leading-relaxed font-sans mb-10">
      <Content />
    </div>

    <!-- 外部導航與回饋列 -->
    <div class="pt-6 border-t border-paper-border flex flex-col sm:flex-row items-center justify-between gap-4">
      {google_maps_url ? (
        <a 
          href={google_maps_url} 
          target="_blank" 
          rel="noopener noreferrer"
          class="w-full sm:w-auto px-5 py-2.5 rounded-xl bg-ink text-white text-xs font-medium hover:bg-accent transition text-center flex items-center justify-center gap-1.5"
        >
          <span>在 Google Maps 開啟定位</span>
          <span>↗</span>
        </a>
      ) : (
        <span class="text-xs text-ink-light font-mono">已無即時導航連結 (時光膠囊)</span>
      )}

      <a 
        href="https://github.com" 
        target="_blank" 
        class="text-xs text-ink-muted hover:text-accent font-mono"
      >
        有資訊需修正？在 GitHub 發起修訂 PR ➔
      </a>
    </div>
  </article>
</BaseLayout>
