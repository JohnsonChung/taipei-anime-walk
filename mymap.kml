    <Folder>
      <name>周邊</name>
      <Placemark>
        <name>animate 台北店</name>
        <description>雖然總是被笑是盤子美特，但是不能否認他的齊全程度，新手入門必逛的店</description>
        <styleUrl>#icon-1502-A52714</styleUrl>
        <Point>
          <coordinates>
            121.5094891,25.0452725,0
          </coordinates>
        </Point>
      </Placemark>
      <Placemark>
        <name>一抽入魂 ToyStore 台北車站店</name>
        <description>種類豐富，價格偏貴，適合逛街，消費請冷靜</description>
        <styleUrl>#icon-1502-A52714</styleUrl>
        <Point>
          <coordinates>
            121.5162058,25.0452988,0
          </coordinates>
        </Point>
      </Placemark>
      <Placemark>
        <name>一抽入魂西門萬年店</name>
        <description>種類豐富，價格偏貴，適合逛，消費請冷靜</description>
        <styleUrl>#icon-1502-A52714</styleUrl>
        <Point>
          <coordinates>
            121.5059687,25.0435584,0
          </coordinates>
